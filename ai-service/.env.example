# Optional. The local evidence-retrieval mode works when these are blank.
# Any OpenAI-compatible provider works. Defaults below are for Google Gemini.
#
# Gemini : key from https://aistudio.google.com  ->  Get API key
#          LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# Groq   : key from https://console.groq.com
#          LLM_BASE_URL=https://api.groq.com/openai/v1
# OpenAI : leave LLM_BASE_URL blank
#
# Confirm the current model name in your provider's console before setting LLM_MODEL.
LLM_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-3.8-flash
